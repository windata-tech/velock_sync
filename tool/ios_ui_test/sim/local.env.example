# Copy to local.env (gitignored) and fill in. Never commit real values.
E2E_SIMULATOR_UDID=
# Velock unlock password of the sandbox used on that simulator.
VELOCK_RUNTIME_PASSWORD=
VELOCK_E2E_SANDBOX_NAME=
# e2e.sh reset stage uninstalls/reinstalls both apps only on this simulator.
# Set it to a dedicated test simulator, never a device holding real data.
E2E_RESET_ALLOWED_UDID=
